# Copy to atlas-vm.env and change what you need. Both scripts read this file.

# Virtual machine
VM_NAME=atlas
VCPU_COUNT=4
MEMORY_MIB=8192
DISK_GIB=24
HOST_ADDRESS=172.16.100.1
VM_ADDRESS=172.16.100.2
SSH_PORT=2222
FORWARD_PORTS=80,443

# Bench and site
BENCH_NAME=atlas
SITE_NAME=atlas.example.com
ADMIN_DOMAIN=admin.example.com
PASSWORD=Atlas#Bench2026x
BENCH_USER=frappe
PILOT_BRANCH=develop
LETSENCRYPT_EMAIL=tanmoy@example.com

# Atlas app
ATLAS_REPOSITORY=https://github.com/frappe/atlas
ATLAS_BRANCH=develop

# First guest image. Leave IMAGE_STORAGE empty to upload to object storage.
UBUNTU_VERSION=24.04
IMAGE_ARCHITECTURE=amd64
IMAGE_STORAGE=site-file
